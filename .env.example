# Leave secrets in .env.local, never in source control.
APP_BASE_URL=http://127.0.0.1:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
# Tiger Data PostgreSQL URL; remote connections enforce sslmode=verify-full.
# Add sslrootcert=/absolute/path/to/trusted-ca.crt if your service needs a CA file.
DATABASE_URL=
GEMINI_API_KEY=
# Supported stable Flash model; can be changed to an account-accessible model.
GEMINI_MODEL=gemini-3.7-flash
