# Future integrations. Leave secrets in .env.local, never in source control.
# The app shell runs without service configuration; Phase 2 generation needs Gemini.
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
DATABASE_URL=
GEMINI_API_KEY=
# Supported stable Flash model; can be changed to an account-accessible model.
GEMINI_MODEL=gemini-3.8-flash
